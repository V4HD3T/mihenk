# Mihenk deployment configuration.
#
#   cp .env.production.example .env
#
# Then fill in the three secrets below. Compose refuses to start without them
# rather than falling back to a default, because a predictable JWT secret means
# anyone who has read this repository can forge a teacher's session.
#
# Generate each with:  openssl rand -base64 32

# --- Secrets: no defaults, must be set -------------------------------------

# Signs session tokens. Changing it logs everyone out, which is also how you
# revoke every session at once if one leaks.
JWT_SECRET=

# The database password. Only ever used inside the compose network.
DB_PASSWORD=

# --- Public identity --------------------------------------------------------

# The origin users type into a browser, including scheme and any non-default
# port. Used to validate WebSocket handshakes, so it must match exactly.
PUBLIC_ORIGIN=http://localhost

# Port nginx publishes on the host. Behind a TLS terminator, keep this internal
# (e.g. 127.0.0.1:8080:80) and let the terminator hold 443.
HTTP_PORT=80

# --- Accounts ---------------------------------------------------------------

# Required to create a teacher account. Leave EMPTY and teacher
# self-registration is disabled entirely - the safest setting once your
# teachers have their accounts.
TEACHER_INVITE_CODE=

# --- Operations -------------------------------------------------------------

# Bearer token for GET /metrics. Leave empty and the endpoint is disabled
# rather than public: queue depth and failure rates are operational detail.
METRICS_TOKEN=

DB_NAME=mihenk
DB_USER=mihenk

# Host-side ports for Postgres and Redis. Bound to 127.0.0.1 only, so the
# grading workers running on the host can reach them and nothing else can.
# Change these if the host already runs its own Postgres or Redis.
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
DB_POOL_MAX=20
LOG_LEVEL=info

# Tag applied to the built images. Set it to the release you are deploying so
# `docker images` tells you what is actually running.
MIHENK_VERSION=latest
