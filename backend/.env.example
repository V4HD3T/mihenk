NODE_ENV=development
PORT=4000

# PostgreSQL connection details (PostgreSQL 12+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codecloud
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
# The server refuses to start in production while this is still the placeholder.
JWT_SECRET=change-this-secret-before-deploying-to-production
JWT_EXPIRES_IN=7d

# Teacher accounts.
# Registration creates a STUDENT unless the request carries this exact code.
# Leave it unset to disable teacher self-registration entirely.
TEACHER_INVITE_CODE=local-dev-teacher-code

# Code execution engine limits
EXEC_TIME_LIMIT_SEC=5
EXEC_MEMORY_LIMIT_KB=524288
EXEC_MAX_OUTPUT_CHARS=100000

# Redis (grading queue + WebSocket cross-process notifications)
REDIS_HOST=localhost
REDIS_PORT=6379

# How many submissions a single worker process grades concurrently.
# Run multiple worker processes (npm run worker) to scale horizontally.
WORKER_CONCURRENCY=4

# CORS - comma-separated list of allowed browser origins.
# There is no wildcard default: anything not listed here is refused.
FRONTEND_ORIGIN=http://localhost:5173

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
EXEC_RATE_LIMIT_MAX=30

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
