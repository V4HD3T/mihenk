PORT=4000

# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codecloud
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change-this-secret-before-deploying-to-production
JWT_EXPIRES_IN=7d

# Code execution engine limits
EXEC_TIME_LIMIT_SEC=5
EXEC_MEMORY_LIMIT_KB=524288
EXEC_MAX_OUTPUT_CHARS=100000

# Redis (grading queue + WebSocket cross-process notifications)
REDIS_HOST=localhost
REDIS_PORT=6379

# How many submissions a single worker process grades concurrently.
# Run multiple worker processes (npm run worker) to scale horizontally.
WORKER_CONCURRENCY=4

# CORS - frontend origin
FRONTEND_ORIGIN=http://localhost:5173
