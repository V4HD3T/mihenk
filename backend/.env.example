NODE_ENV=development
PORT=4000

# PostgreSQL connection details (PostgreSQL 12+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codecloud
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
# The server refuses to start in production while this is still the placeholder.
JWT_SECRET=change-this-secret-before-deploying-to-production
JWT_EXPIRES_IN=7d

# Teacher accounts.
# Registration creates a STUDENT unless the request carries this exact code.
# Leave it unset to disable teacher self-registration entirely.
TEACHER_INVITE_CODE=local-dev-teacher-code

# Code execution engine limits
# Wall clock for one run of a submission.
EXEC_TIME_LIMIT_SEC=5
# Compiling gets its own, larger budget: a templated C++ file can take longer to
# compile than the problem's whole run budget.
EXEC_COMPILE_TIME_LIMIT_SEC=30
EXEC_MEMORY_LIMIT_KB=524288
EXEC_MAX_OUTPUT_CHARS=100000

# How submitted code is isolated:
#   docker - every compile and test case runs in a throwaway, network-less
#            container. Required for untrusted users. Refuses to grade if no
#            Docker daemon is reachable, rather than running code unconfined.
#   host   - runs directly on this machine (timeout + ulimit only). Convenient
#            for solo development; NOT safe for untrusted users.
#   auto   - docker when available, otherwise host. Fine for development,
#            never for production: it degrades silently.
# Build the images first: npm run sandbox:build
SANDBOX_MODE=auto
SANDBOX_IMAGE_PREFIX=codecloud

# Per-container limits (docker mode). These govern instead of
# EXEC_MEMORY_LIMIT_KB, which only applies to the host backend.
SANDBOX_MEMORY_MB=256
SANDBOX_JAVA_MEMORY_MB=384
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_MB=16

# Redis (grading queue + WebSocket cross-process notifications)
REDIS_HOST=localhost
REDIS_PORT=6379

# How many submissions a single worker process grades concurrently.
# Run multiple worker processes (npm run worker) to scale horizontally.
WORKER_CONCURRENCY=4

# CORS - comma-separated list of allowed browser origins.
# There is no wildcard default: anything not listed here is refused.
FRONTEND_ORIGIN=http://localhost:5173

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
EXEC_RATE_LIMIT_MAX=30

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Prometheus scrape endpoint (GET /metrics), as a bearer token.
# Queue depth and failure rates are operational detail: leave this UNSET and the
# endpoint is disabled entirely rather than served publicly.
# METRICS_TOKEN=

# PostgreSQL connection pool. The pool size is the ceiling on concurrent work
# that touches the database, so keep it at least as large as the total worker
# concurrency it serves.
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Autoscaling worker pool (npm run worker:pool).
WORKER_POOL_MIN=1
WORKER_POOL_MAX=8
# Queued+active jobs one worker absorbs before another is added.
WORKER_POOL_BACKLOG_PER_WORKER=10
WORKER_POOL_INTERVAL_MS=5000
# Consecutive quiet intervals before shrinking, so a lull between two waves of
# submissions doesn't cost the startup time of rebuilding the pool.
WORKER_POOL_SCALE_DOWN_TICKS=6
